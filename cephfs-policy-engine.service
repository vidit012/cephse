[Unit]
Description=CephFS Tiering Policy Engine
After=network.target postgresql.service cephfs-tracker.service
Requires=postgresql.service
Wants=cephfs-tracker.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/cephvm/tiering_system
ExecStart=/usr/bin/python3 /home/cephvm/tiering_system/src/policy_engine_optimized.py --interval 60
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=10

# Graceful shutdown
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target