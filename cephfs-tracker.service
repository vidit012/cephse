[Unit]
Description=CephFS File Access Tracker (eBPF)
After=network.target postgresql.service ceph.target
Requires=postgresql.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/cephvm/tiering_system
ExecStart=/usr/bin/python3 /home/cephvm/tiering_system/src/tracker_phase1.py
StandardOutput=journal
StandardError=journal
Restart=always
RestartSec=10
KillMode=process
KillSignal=SIGINT

# Security settings
NoNewPrivileges=false
PrivateTmp=yes

# Resource limits
MemoryMax=512M
CPUQuota=50%

[Install]
WantedBy=multi-user.target
