graph TB
    %% ==========================================
    %% STYLING DEFINITIONS
    %% ==========================================
    classDef user fill:#E3F2FD,stroke:#1565C0,stroke-width:2px,color:#0D47A1;
    classDef kernel fill:#FFEBEE,stroke:#C62828,stroke-width:2px,color:#B71C1C;
    classDef service fill:#E8F5E9,stroke:#2E7D32,stroke-width:2px,color:#1B5E20;
    classDef db fill:#FFF3E0,stroke:#EF6C00,stroke-width:2px,color:#E65100;
    classDef storage fill:#F3E5F5,stroke:#7B1FA2,stroke-width:2px,color:#4A148c;
    classDef flow stroke:#546E7A,stroke-width:2px,fill:none;

    %% ==========================================
    %% NODES & SUBGRAPHS
    %% ==========================================
    
    subgraph ClientNode [Client Compute Node]
        direction TB
        App((User App)):::user
        
        %% Kernel Space
        VFS[Cephfs Mount layer]:::kernel
        eBPF[eBPF Probes]:::kernel
        
        %% Tracking Service
        Tracker[Tracker Agent]:::service
        Buffer[In-Memory Buffer]:::service
    end

    subgraph ControlPlane [Control Plane]
        direction TB
        
        subgraph Database [PostgreSQL Metadata Store]
            HotTable[(Hot Table Log)]:::db
            ColdTable[(Metadata)]:::db
            
            %% Stored Procedures
            SP_Agg[Aggregator SP]:::db
            SP_Policy[Policy Engine SP]:::db
            SP_Score[Scoring Logic SP]:::db
        end
        
        subgraph PolicySvc [Policy Service]
            PolicyEng[Policy Engine Python]:::service
        end
        
        subgraph Mgmt [Management Plane]
            SwitchScript[switch_tiering.sh]:::service
        end
    end

    subgraph MigrationPlane [Data Plane Migration]
        direction TB
        
        subgraph MigWorker [Migration Worker]
            Worker[Worker Agent Python]:::service
            LibCeph[libcephfs Binary]:::service
        end
    end

    subgraph StorageCluster [Ceph Storage Cluster]
        PoolHot[Hot Pool NVMe]:::storage
        PoolWarm[Warm Pool SSD]:::storage
        PoolCold[Cold Pool HDD]:::storage
    end

    %% ==========================================
    %% DATA FLOWS
    %% ==========================================
    
    %% 1. Tracking Flow
    App -->|File Access| VFS:::flow
    VFS -.->|Trigger| eBPF:::flow
    eBPF -->|Events| Tracker:::flow
    Tracker -->|Batch| Buffer:::flow
    Buffer -->|Async Flush| HotTable:::flow
    
    %% 2. Aggregation Flow
    Tracker -.->|Periodic Call| SP_Agg:::flow
    SP_Agg -->|Read & Clear| HotTable:::flow
    SP_Agg -->|Update Stats| ColdTable:::flow
    SP_Agg -->|Calc Score| SP_Score:::flow
    
    %% 3. Policy Flow
    PolicyEng -->|Trigger| SP_Policy:::flow
    SP_Policy -->|Read Stats| ColdTable:::flow
    SP_Policy -->|Mark Migration| ColdTable:::flow
    
    %% 4. Management Flow
    SwitchScript -.->|Modify & Restart| PolicyEng:::flow
    
    %% 5. Migration Flow
    Worker -->|Poll Candidates| ColdTable:::flow
    Worker -->|Execute| LibCeph:::flow
    LibCeph -->|Move Data| PoolHot:::flow
    LibCeph -->|Move Data| PoolWarm:::flow
    LibCeph -->|Move Data| PoolCold:::flow
    
    %% 6. Feedback Loop
    LibCeph -->|Result| Worker:::flow
    Worker -->|Update Status| ColdTable:::flow
